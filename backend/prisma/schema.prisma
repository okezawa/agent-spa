// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  OPEN
  MAINTENANCE
}

enum BookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id                 Int               @id @default(autoincrement())
  firstName          String
  lastName           String
  email              String            @unique
  phone              String?
  branch             String
  position           String?
  passwordHash       String?
  profileImage       String?
  status             ApprovalStatus    @default(PENDING)
  approvedAt         DateTime?
  approvedBy         String?
  serviceAssignments ServiceProvider[]
  bookings           Booking[]        @relation("BookingPrimaryEmployee")
  bookingAssignments BookingEmployee[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Branch {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  name      String       @unique
  address   String?
  phone     String?
  status    BranchStatus @default(ACTIVE)
  rooms     Room[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Service {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  durationMinutes Int
  pricePerUnit    Decimal           @db.Decimal(10, 2)
  providers       ServiceProvider[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ServiceProvider {
  serviceId  Int
  employeeId Int
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([serviceId, employeeId])
  @@index([employeeId])
}

model Room {
  id        Int        @id @default(autoincrement())
  name      String
  roomType  String
  color     String     @default("#2563EB")
  status    RoomStatus @default(OPEN)
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([branchId, name])
  @@index([branchId])
}

model Guest {
  id          Int      @id @default(autoincrement())
  memberCode  String   @unique
  firstName   String
  lastName    String
  citizenId   String   @unique
  dateOfBirth DateTime?
  address     String?
  phone       String
  country     String
  lineId      String?
  otherNotes  String?
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id         Int           @id @default(autoincrement())
  guestId    Int?
  guestName  String
  guestPhone String?
  roomId     Int
  serviceId  Int
  employeeId Int
  startAt    DateTime
  endAt      DateTime
  status     BookingStatus @default(BOOKED)
  notes      String?
  guest      Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  service    Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  employee   Employee       @relation("BookingPrimaryEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedEmployees BookingEmployee[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([startAt])
  @@index([roomId, startAt])
  @@index([employeeId, startAt])
}

model BookingEmployee {
  bookingId  Int
  employeeId Int
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([bookingId, employeeId])
  @@index([employeeId])
}
